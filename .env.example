# Public application URL, for example https://your-project.vercel.app
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase server-side persistence
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ElevenLabs ElevenAgents + imported Twilio number
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
ELEVENLABS_PHONE_NUMBER_ID=
ELEVENLABS_WEBHOOK_SECRET=
# Leave unset unless your ElevenLabs workspace supports a residency endpoint.
ELEVENLABS_API_BASE_URL=https://api.elevenlabs.io

# The only destination the application is permitted to call.
# Use E.164 format, such as +91XXXXXXXXXX, and only a number you control
# or have explicit permission to call.
AUTHORIZED_DEMO_PHONE_NUMBER=

# Razorpay Test Mode only
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
